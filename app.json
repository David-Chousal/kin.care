{
  "expo": {
    "name": "Kin",
    "slug": "kin-care",
    "scheme": "kincare",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/app_icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "bundleIdentifier": "com.dchousal.kincare",
      "buildNumber": "1",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.dchousal.kincare",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/app_icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "f94b78ad-c790-43d7-a030-94eb40f47bfa"
      }
    },
    "plugins": [
      "./plugins/withSentryDisableUploadDefault.js",
      "@react-native-async-storage/expo-with-async-storage",
      "@react-native-community/datetimepicker",
      "@sentry/react-native",
      [
        "expo-notifications",
        {
          "color": "#ffffff",
          "defaultChannel": "default",
          "enableBackgroundRemoteNotifications": false
        }
      ],
      "expo-localization",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Kin to access your photos to set your profile picture.",
          "cameraPermission": "Allow Kin to use the camera for your profile picture."
        }
      ]
    ],
    "owner": "dchousal"
  }
}
